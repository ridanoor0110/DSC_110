        "#this function classifies bmi according to a value entered into it. The value entered is assigned to the variable weight, and is compared to the criteria of each bmi index and then returns the according category of bmi for that weight.\n",
        "def bmi(weight):\n",
        "  if weight < 18:\n",
        "    print(\"Underweight\")\n",
